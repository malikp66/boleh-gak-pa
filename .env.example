# Lokal: jalankan `neon env pull` (mengisi .env otomatis). Vercel: isi di Settings → Environment Variables.
# JANGAN commit file .env.

# --- Neon Postgres ---
DATABASE_URL=            # pooled (-pooler) untuk aplikasi
DATABASE_URL_UNPOOLED=   # direct, untuk `npm run migrate`

# --- AI ---
AI_PROVIDER=google            # google | ollama
GOOGLE_AI_API_KEY=            # aistudio.google.com → Get API key
AI_TEXT_MODEL=gemini-3.1-flash-lite   # teks: termurah di Gemini 3
AI_VISION_MODEL=gemini-3.8-flash       # foto: lebih akurat, dibatasi AI_LIMIT_PHOTO
AI_TTS_MODEL=gemini-3.8-flash-lite-tts # suara AI natural (opsional, ±$0.0012 per 8 detik)
AI_THINKING_TEXT=minimal               # token thinking ditagih sebagai output
AI_THINKING_VISION=low
# OLLAMA_HOST=http://127.0.0.1:11434   # kalau AI_PROVIDER=ollama

# --- Rem biaya & penyalahgunaan ---
AI_MONTHLY_BUDGET_USD=5       # lewat dari ini → otomatis mode tabel sampai bulan depan
AI_LIMIT_ASSESS=30
AI_LIMIT_PHOTO=8
AI_LIMIT_ANALYZE=10
AI_LIMIT_SUMMARY=3
AI_LIMIT_TTS=40
DEVICES_PER_IP_PER_DAY=20

# --- Notifikasi pengingat (web push) ---
# Buat sekali: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/malikp66/boleh-gak-pa
# Rahasia untuk Vercel Cron (vercel.json: 07.00 & 19.00 WIB). Vercel mengirimnya otomatis sebagai Bearer token.
CRON_SECRET=

# WhatsApp Business Platform (Cloud API resmi Meta) — masuk dengan WA & bel lewat WA
WA_PHONE_NUMBER_ID=              # API Setup → Phone number ID (bukan nomor HP)
WA_ACCESS_TOKEN=                 # token permanen dari System User (Business Settings)
WA_APP_SECRET=                   # App settings → Basic → App secret (untuk cek tanda tangan webhook)
WA_BUSINESS_NUMBER=628xxxxxxxxxx # nomor WA aplikasi, format internasional tanpa +
WA_VERIFY_TOKEN=                 # teks acak bebas, sama dengan yang diisi di dashboard webhook
WA_TEMPLATE_NUDGE=               # opsional: nama template utility untuk bel di luar jendela 24 jam
WA_GRAPH_VERSION=v23.0

# Upstash Redis (opsional, disarankan di produksi): cache /api/me, jatah AI, cache jawaban AI, rate limit.
# Buat database di region yang SAMA dengan Neon & Vercel: ap-southeast-1 (Singapura). Tanpa ini aplikasi tetap jalan memakai Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
