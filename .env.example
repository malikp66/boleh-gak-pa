# Salin jadi .env.local (lokal) dan isi juga di Vercel → Settings → Environment Variables.
# JANGAN commit file .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Rahasia, hanya server: dipakai untuk cache jawaban AI saja
SUPABASE_SECRET_KEY=

# --- AI ---
AI_PROVIDER=google            # google | ollama
GOOGLE_AI_API_KEY=            # aistudio.google.com → Get API key
AI_TEXT_MODEL=gemma-3-12b-it  # keluarga Gemma 3 = paling murah
AI_VISION_MODEL=gemma-3-12b-it
# OLLAMA_HOST=http://127.0.0.1:11434   # kalau AI_PROVIDER=ollama

# --- Batas AI harian per pengguna (rem biaya) ---
AI_LIMIT_ASSESS=30
AI_LIMIT_PHOTO=8
AI_LIMIT_ANALYZE=10
AI_LIMIT_SUMMARY=3
